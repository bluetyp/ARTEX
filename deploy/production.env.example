# Copy to /mnt/ebs-data/services/artex/.env (chmod 600).
# Use a generated hex password: it is safe in the PostgreSQL URL.
POSTGRES_PASSWORD=replace-with-random-hex
STATE_ROOT=/mnt/ebs-data/services/artex/state
APP_PORT=18500
PROXY_PORT=18501
OIDC_SECRET_PATH=/mnt/ebs-data/services/artex/secrets/artex-oidc-client-secret
OIDC_CA_BUNDLE=/mnt/ebs-data/services/artex/trust/ca-bundle.pem
# ARTEX_IMAGE is written to image.env by deploy.sh after a successful rollout.
